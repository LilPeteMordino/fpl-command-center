# --- Local data -------------------------------------------------------------------
# The synced SQLite database is a local build artifact (regenerated by sync_data.py / the
# sidebar's "Sync Live FPL Data"), not source -- but data/ itself (and its .gitkeep) stays
# tracked so the directory exists on a fresh clone/deploy for get_connection()'s mkdir to fill.
data/*.db
data/*.sqlite3
data/*.sqlite3-journal
